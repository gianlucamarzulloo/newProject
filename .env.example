# Copia in .env (o imposta nel pannello dell'hosting) e compila.
# I commenti stanno su righe separate: dopo "=" va solo il valore.

# URL pubblico del sito, senza "/" finale (serve per sitemap e link canonici)
ENGLAB_SITE_URL=https://www.tuodominio.it
ENGLAB_SITE_NAME=EngLab

# --- Guadagni ---
# Google AdSense: lasciali vuoti finché l'account non è approvato.
# Client es. ca-pub-1234567890123456; slot = id di un'unità "display" responsive.
ENGLAB_ADSENSE_CLIENT=
ENGLAB_ADSENSE_SLOT=
# Pagina per le donazioni (Ko-fi, Buy Me a Coffee, PayPal.me), es. https://ko-fi.com/tuonome
ENGLAB_DONATE_URL=

# --- Statistiche e contatti ---
# Dominio registrato su Plausible (analytics senza cookie), es. tuodominio.it
ENGLAB_PLAUSIBLE_DOMAIN=
ENGLAB_CONTACT_EMAIL=

# --- Protezione del server ---
# Secondi massimi per calcolo
ENGLAB_TIMEOUT=10
# Calcoli in parallelo: 2 su piani da 512 MB, 4 o più con 1-2 GB di RAM
ENGLAB_MAX_CONCURRENT=2
# Richieste al minuto per IP
ENGLAB_RATE_PER_MINUTE=30
